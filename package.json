{
  "name": "cola-verify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:labels": "tsx --env-file=.env.local scripts/generate-test-labels.ts",
    "eval:quick": "tsx scripts/run-fixture-evals.ts --verbose --only 01-pass-01,02-mismatch-01,03-noncompliant-01,04-noncompliant-04,05-warning-bad-01,06-warning-sneaky-01",
    "eval:full": "tsx scripts/run-fixture-evals.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "next": "16.2.4",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "uuid": "^14.0.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
